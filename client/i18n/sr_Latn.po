msgstr "Skini"

#: client/scripts/screens/game_screen_hero.gd:184
msgid "%s set (%d of %d worn): %s"
msgstr "Komplet %s (nosi %d od %d): %s"

#: client/scripts/screens/game_screen_hero.gd:187
msgid "No gear yet."
msgstr "Još nema opreme."

#: client/scripts/screens/game_screen_hero.gd:187
msgid "Beaten hordes sometimes leave gear behind for a hero who fought them."
msgstr "Pobeđene horde ponekad ostave opremu junaku koji se borio protiv njih."

#: client/scripts/screens/game_screen_hero.gd:198
msgid "Wear"
msgstr "Obuci"

#: client/scripts/screens/game_screen_hero.gd:211
msgid "Found another village to send the hero there."
msgstr "Osnuj još jedno selo da bi junaka poslao tamo."

#: client/scripts/screens/game_screen_hero.gd:217
msgid "Name"
msgstr "Ime"

#: client/scripts/screens/game_screen_hero.gd:219
msgid "New name"
msgstr "Novo ime"

#: client/scripts/screens/game_screen_hero.gd:225
msgid "Rename"
msgstr "Preimenuj"

#: client/scripts/screens/game_screen_hero.gd:230
msgid "The hero rides out alone: no garrison to lead while away, and a chance to come back wounded. New quests every few hours."
msgstr "Junak jaše sam: dok je odsutan ne predvodi posadu i može se vratiti ranjen. Novi zadaci na svakih nekoliko sati."

#: client/scripts/screens/game_screen_hero.gd:238
msgid "Back in %s"
msgstr "Vraća se za %s"

#: client/scripts/screens/game_screen_hero.gd:241
msgid "Called off: coming home empty-handed."
msgstr "Opozvano: vraća se praznih ruku."

#: client/scripts/screens/game_screen_hero.gd:243
msgid "Call off the quest"
msgstr "Opozovi zadatak"

#: client/scripts/screens/game_screen_hero.gd:244
msgid "The hero turns for home where it is (as far back as it went, or from the place itself) and brings nothing back. Once on the way home, it can't be called off."
