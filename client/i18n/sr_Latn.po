#: client/scripts/game/battle_story.gd:189
msgid "%s fell on their side."
msgstr "Na njihovoj strani palo je %s."

#: client/scripts/game/battle_story.gd:189
msgid "None of them fell."
msgstr "Niko od njih nije pao."

#: client/scripts/game/battle_story.gd:190
msgid "We lost %s."
msgstr "Izgubili smo %s."

#: client/scripts/game/battle_story.gd:190
msgid "We lost no one."
msgstr "Nismo izgubili nikoga."

#: client/scripts/game/battle_story.gd:195
msgid "Our ballistae smashed %s."
msgstr "Naše baliste su razbile %s."

#: client/scripts/game/battle_story.gd:197
msgid "The army from %s broke and fell back home."
msgstr "Vojska iz %s se slomila i povukla kući."

#: client/scripts/game/battle_story.gd:199
msgid "The Holy City's guard broke and fights no more."
msgstr "Straža Svetog grada se slomila i više se ne bori."

#: client/scripts/game/battle_story.gd:199
msgid "The garrison broke and fights no more."
msgstr "Garnizon se slomio i više se ne bori."

#: client/scripts/game/battle_story.gd:207
msgid "In the hospital, %s got up again."
msgstr "U bolnici je ustalo %s."

#: client/scripts/game/battle_story.gd:218
msgid "The enemy broke and fled. The field is ours."
msgstr "Neprijatelj je slomljen i pobegao. Polje je naše."

#: client/scripts/game/battle_story.gd:218
msgid "We fell back; they still hold their ground."
msgstr "Povukli smo se; oni još drže svoj položaj."

#: client/scripts/game/battle_story.gd:220
msgid "The last of them fell. The camp is ours to burn."
