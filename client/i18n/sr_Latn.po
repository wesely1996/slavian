#: client/scripts/screens/game_screen_hero.gd:83
msgid "Its own gifts count in all your villages; what its skills and gear add counts where it stands, and for the army it leads."
msgstr "Njegovi sopstveni darovi važe u svim tvojim selima; ono što dodaju veštine i oprema važi tamo gde stoji i za vojsku koju predvodi."

#: client/scripts/screens/game_screen_hero.gd:85
msgid "Level %d · %s"
msgstr "Nivo %d · %s"

#: client/scripts/screens/game_screen_hero.gd:91
msgid "No bonuses yet."
msgstr "Još nema bonusa."

