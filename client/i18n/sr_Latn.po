#: client/scripts/game/army_text.gd:13
msgid "Explore: fights any guardians, searches the site for some hours and brings home what it finds. Scouts may go too."
msgstr "Istraživanje: bori se sa čuvarima, pretražuje drevno mesto nekoliko sati i donosi kući što nađe. Mogu ići i izviđači."

