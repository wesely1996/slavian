msgstr "Almanah"

#: client/scripts/screens/game_screen_messages.gd:76
msgid "Tutorial"
msgstr "Uputstvo"

#: client/scripts/screens/game_screen_messages.gd:77
msgid "Report a bug"
msgstr "Prijavi grešku"

#: client/scripts/screens/game_screen_messages.gd:78
msgid "Worlds"
msgstr "Svetovi"

#: client/scripts/screens/game_screen_messages.gd:113
msgid "The tutorial is for a running world with a village of your own."
msgstr "Uputstvo je za svet u toku u kome imaš svoje selo."

#: client/scripts/screens/game_screen_messages.gd:154
msgid "Onward"
msgstr "Napred"

#: client/scripts/screens/game_screen_messages.gd:228
msgid "No camps on the map yet: they rise where a horde was beaten."
msgstr "Još nema logora na mapi: nastaju tamo gde je horda poražena."

#: client/scripts/screens/game_screen_messages.gd:287
msgid "Hordes will come from the edges of the map, wave after wave. Hold your villages, help your group, and build the Kalinov Bridge in the Holy City before it falls."
msgstr "Horde će dolaziti sa ivica mape, talas za talasom. Odbrani svoja sela, pomaži svojoj grupi i sagradi Kalinov most u Svetom gradu pre nego što padne."

#: client/scripts/screens/game_screen_messages.gd:288
msgid "The quest card at the top of the map shows what to do next, with Show me to point the way and a reward for each step."
msgstr "Kartica zadataka na vrhu mape pokazuje šta je sledeće, sa dugmetom Pokaži mi koje pokazuje put i nagradom za svaki korak."

#: client/scripts/screens/game_screen_messages.gd:292
msgid "Or skip the tutorial: %d%% of its rewards come at once, with a %s (level %d) to hold them."
msgstr "Ili preskoči uvod: %d%% njegovih nagrada stiže odmah, uz zgradu %s (nivo %d) da ih čuva."

#: client/scripts/screens/game_screen_messages.gd:294
msgid "Welcome to %s"
msgstr "Dobro došao u %s"

#: client/scripts/screens/game_screen_messages.gd:294
msgid "Let's begin"
msgstr "Počnimo"

#: client/scripts/screens/game_screen_messages.gd:294
