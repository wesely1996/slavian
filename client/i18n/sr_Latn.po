msgstr "Gvozdeni ljuskasti oklop"

#: data/research.json
msgid "Scales of iron sewn on leather: +5% defense, and +5% more for infantry."
msgstr "Gvozdene ljuske ušivene na kožu: +5% odbrane, i još +5% za pešadiju."

#: data/research.json
msgid "Lance Charges"
msgstr "Juriši kopljima"

#: data/research.json
msgid "Couched lances and stirrups: cavalry strikes 15% harder."
msgstr "Spuštena koplja i uzengije: konjica udara 15% jače."

#: data/research.json
msgid "War Drums"
msgstr "Ratni bubnjevi"

#: data/research.json
msgid "The drums keep the line together: +5% attack for every troop."
msgstr "Bubnjevi drže stroj na okupu: +5% napada za svaku jedinicu."

#: data/research.json
msgid "Stone Keeps"
msgstr "Kamene kule"

#: data/research.json
msgid "A stone keep at the heart of every village: defenders at home +15%, and raiders carry off 15% less."
msgstr "Kamena kula u srcu svakog sela: branioci kod kuće +15%, a pljačkaši odnose 15% manje."

#: data/research.json
msgid "Night Runners"
msgstr "Noćni trkači"

#: data/research.json
msgid "Scouts who move by night: +10% survival and 10% faster."
msgstr "Izviđači koji se kreću noću: +10% preživljavanja i 10% brže."

#: data/research.json
msgid "Caravan Guilds"
msgstr "Karavanski esnafi"

#: data/research.json
msgid "Guild drivers and spare teams: caravans travel 15% faster and carry 15% more."
msgstr "Esnafski kočijaši i rezervne zaprege: karavani putuju 15% brže i nose 15% više."

#: data/research.json
msgid "Dazhbog's Harvest"
msgstr "Dažbogova žetva"

#: data/research.json
msgid "Offerings to the sun bring good years: +5% of every resource."
msgstr "Žrtve suncu donose dobre godine: +5% svakog resursa."

#: data/scouting.json
msgid "rough"
msgstr "grub"

#: data/scouting.json
msgid "detailed"
msgstr "detaljan"

#: data/scouting.json
msgid "exact"
msgstr "tačan"

#: data/sites.json
msgid "Kurgan"
msgstr "Kurgan"

#: data/sites.json
msgid "A burial mound of the old chieftains."
msgstr "Grobna humka starih poglavica."

#: data/sites.json
msgid "Sunken Shrine"
msgstr "Potonulo svetilište"

#: data/sites.json
msgid "A shrine the marsh swallowed, its idols still dry inside."
msgstr "Svetilište koje je močvara progutala, a idoli su unutra još suvi."

#: data/sites.json
msgid "Old Hillfort"
msgstr "Staro gradište"

#: data/sites.json
msgid "Earthworks of a forgotten clan."
msgstr "Zemljani bedemi zaboravljenog klana."

#: data/sites.json
msgid "Stone Idol"
msgstr "Kameni idol"

#: data/sites.json
msgid "A four-faced idol, worn smooth by centuries of rain."
msgstr "Četvorolični idol, uglačan vekovima kiše."

#: data/sites.json
msgid "Frozen Ruin"
msgstr "Zaleđena ruševina"

#: data/sites.json
msgid "Halls under the ice, warm at their heart."
msgstr "Dvorane pod ledom, tople u svom srcu."

#: data/terrain.json
msgid "Plains"
msgstr "Ravnica"

#: data/terrain.json
msgid "Forest"
msgstr "Šuma"

#: data/terrain.json
msgid "Hills"
msgstr "Brda"

#: data/terrain.json
msgid "Wooded Hills"
msgstr "Šumovita brda"

#: data/terrain.json
msgid "Mountain"
msgstr "Planina"

#: data/terrain.json
msgid "Swamp"
msgstr "Močvara"

#: data/terrain.json
msgid "Lake"
msgstr "Jezero"

#: data/terrain.json
msgid "Holy City"
msgstr "Sveti grad"

#: data/terrain.json
msgid "Ocean"
msgstr "More"

#: data/terrain.json
msgid "Dark Forest"
msgstr "Mračna šuma"

#: data/terrain.json
msgid "Ice"
msgstr "Led"

#: data/terrain.json
msgid "Steppe"
msgstr "Stepa"

#: data/terrain.json
msgid "Hallowed Lands"
msgstr "Osveštana zemlja"

#: data/units.json
msgid "Axe Levy"
msgstr "Sekiraški ustanik"

#: data/units.json
msgid "Farmers with their wood axes: cheap, quick to raise, soon spent."
msgstr "Seljaci sa sekirama za drva: jeftini, brzo se skupe, brzo se potroše."

#: data/units.json
msgid "Warrior"
msgstr "Ratnik"

#: data/units.json
msgid "A free man with spear, axe and shield: good at a little of everything."
msgstr "Slobodan čovek sa kopljem, sekirom i štitom: dobar u pomalo svemu."

#: data/units.json
msgid "Spearman"
msgstr "Kopljanik"

#: data/units.json
msgid "Cheap, steady infantry that holds the walls and stops riders."
msgstr "Jeftina, postojana pešadija koja drži zidine i zaustavlja konjanike."

#: data/units.json
msgid "Axeman"
msgstr "Sekiraš"

#: data/units.json
msgid "Hits hard with a long axe, but his shield is small."
msgstr "Udara snažno dugom sekirom, ali mu je štit mali."

#: data/units.json
msgid "Ambusher"
msgstr "Zasedaš"

#: data/units.json
msgid "Waits in the brush and falls on archers before they can loose."
msgstr "Čeka u šipražju i obara se na strelce pre nego što odapnu."

#: data/units.json
msgid "Horse Cutter"
msgstr "Konjosek"

#: data/units.json
msgid "Hooked blades for the legs of horses: riders dread him."
msgstr "Kukasta sečiva za konjske noge: jahači ga se plaše."

#: data/units.json
msgid "Warrior of Perun"
msgstr "Perunov ratnik"

#: data/units.json
msgid "Sworn to the Thunderer: steady in the line and hard in the charge."
msgstr "Zakleti Gromovniku: postojani u stroju i žestoki u jurišu."

#: data/units.json
msgid "Axe Warrior"
msgstr "Ratnik sa sekirom"

#: data/units.json
msgid "A seasoned axeman in mail who cleaves through shields."
msgstr "Prekaljeni sekiraš u verižnjači koji cepa štitove."

#: data/units.json
msgid "Follower of Veles"
msgstr "Velesov sledbenik"

#: data/units.json
msgid "Keepers of the herds and the old roads; they give ground slowly."
msgstr "Čuvari stada i starih puteva; teško popuštaju."

#: data/units.json
msgid "Horse Butcher"
msgstr "Konjokolj"

#: data/units.json
msgid "Long-hafted blades that bring down horse and rider together."
msgstr "Sečiva na dugim drškama koja obaraju i konja i jahača."

#: data/units.json
msgid "Large Shield"
msgstr "Veliki štit"

#: data/units.json
msgid "A wall of tall shields: slow, and almost impossible to break."
msgstr "Zid od visokih štitova: spor i gotovo neprobojan."

#: data/units.json
msgid "Noble Spearman"
msgstr "Plemićki kopljanik"

#: data/units.json
msgid "A boyar's son with a long spear and good mail; riders break on him."
msgstr "Bojarski sin sa dugim kopljem i dobrom verižnjačom; jahači se lome o njega."

#: data/units.json
msgid "Champion of Perun"
msgstr "Perunov prvak"

#: data/units.json
msgid "The Thunderer's best: they strike first and fall last."
msgstr "Gromovnikovi najbolji: prvi udaraju, poslednji padaju."

#: data/units.json
msgid "Perun's Axe"
msgstr "Perunova sekira"

#: data/units.json
msgid "Axes blessed under the oak of Perun; nothing stands in front of them for long."
msgstr "Sekire blagoslovene pod Perunovim hrastom; ništa pred njima dugo ne stoji."

#: data/units.json
msgid "Veles' Chosen"
msgstr "Velesov izabranik"

#: data/units.json
msgid "Veles marks them for his own; they hold where others run."
msgstr "Veles ih obeležava kao svoje; drže se gde drugi beže."

#: data/units.json
msgid "Chosen Shield"
msgstr "Izabrani štit"

#: data/units.json
msgid "The steadiest shields of the land, set where the line must not break."
msgstr "Najpostojaniji štitovi u zemlji, postavljeni gde stroj ne sme da pukne."

#: data/units.json
msgid "Warlord's Guard"
msgstr "Vojvodina garda"

#: data/units.json
msgid "The warlord's own sworn men, the best armed in the land."
msgstr "Vojvodini zakleti ljudi, najbolje naoružani u zemlji."

#: data/units.json
msgid "Battering Ram"
msgstr "Ovan"

#: data/units.json
msgid "An iron-capped log under a hide roof: little use in the open, but every ram takes a quarter of a stronghold's walls off its defenders (raids and strikes on horde encampments)."
msgstr "Balvan okovan gvožđem pod krovom od kože: malo koristi na otvorenom, ali svaki ovan skida četvrtinu zidina tvrđave njenim braniocima (pohodi i udari na logore hordi)."

#: data/units.json
msgid "Archer"
msgstr "Strelac"

#: data/units.json
msgid "Shoots hard at infantry; riders cut them down."
msgstr "Snažno gađa pešadiju; konjanici ih seku."

#: data/units.json
msgid "Skirmisher"
msgstr "Kopljobacač"

#: data/units.json
msgid "Throws javelins and runs; quick on his feet."
msgstr "Baca koplja i beži; brz na nogama."

#: data/units.json
msgid "Poison Archer"
msgstr "Otrovni strelac"

#: data/units.json
msgid "Arrows dipped in hemlock: a graze is enough."
msgstr "Strele umočene u kukutu: dovoljna je ogrebotina."

#: data/units.json
msgid "Hunter"
msgstr "Lovac"

#: data/units.json
msgid "Hunts boar in the deep forest; he does not miss twice."
msgstr "Lovi veprove u dubokoj šumi; ne promašuje dvaput."

#: data/units.json
msgid "Noble Skirmisher"
msgstr "Plemićki kopljobacač"

#: data/units.json
msgid "Well-armed javelin men who hold their ground better than most."
msgstr "Dobro naoružani bacači koplja koji se drže bolje od većine."

#: data/units.json
msgid "Poison Hunter"
msgstr "Otrovni lovac"

#: data/units.json
msgid "Knows every poison of the marsh and the root."
msgstr "Zna svaki otrov iz močvare i iz korena."

#: data/units.json
msgid "Onager"
msgstr "Onagar"

#: data/units.json
msgid "A throwing engine that hurls stones into packed ranks; slow to move."
msgstr "Bacačka sprava koja baca kamenje u zbijene redove; spora za premeštanje."

#: data/units.json
msgid "Scorpion"
msgstr "Škorpija"

#: data/units.json
msgid "A great crossbow on a frame that drives a bolt through horse and rider alike; slow to move."
msgstr "Veliki samostrel na postolju koji strelom probija i konja i jahača; spor u pokretu."

#: data/units.json
msgid "Devana's Hunter"
msgstr "Devanin lovac"

#: data/units.json
msgid "Huntress of the goddess of the forest: swift and deadly."
msgstr "Lovkinja boginje šume: brza i smrtonosna."

#: data/units.json
msgid "Perun's Thunder Thrower"
msgstr "Perunov gromobacač"

#: data/units.json
msgid "Hurls fire-pots that burst like Perun's lightning."
msgstr "Baca ognjene lonce koji pucaju kao Perunova munja."

#: data/units.json
msgid "Horse Raider"
msgstr "Konjanik pljačkaš"

#: data/units.json
msgid "Riders who strike hard and run down archers."
msgstr "Jahači koji snažno udaraju i gaze strelce."

#: data/units.json
msgid "Raider"
msgstr "Pljačkaš"

#: data/units.json
msgid "Light riders who carry off a great load and are gone before the alarm."
msgstr "Laki jahači koji odnesu veliki tovar i nestanu pre uzbune."

#: data/units.json
msgid "Shoots from the saddle and rides out of reach."
msgstr "Gađa iz sedla i odjaše van domašaja."

#: data/units.json
msgid "Bear Rider"
msgstr "Jahač na medvedu"

#: data/units.json
msgid "A warrior on a tamed bear: slow for a rider, terrible in the charge."
msgstr "Ratnik na pripitomljenom medvedu: spor za jahača, strašan u jurišu."

#: data/units.json
msgid "Svarog's Raider"
msgstr "Svarogov pljačkaš"

#: data/units.json
msgid "Riders of Svarog's fire: the fastest and hardest strike the land has."
msgstr "Jahači Svarogove vatre: najbrži i najteži udarac koji zemlja ima."

#: data/units.json
msgid "Scout"
msgstr "Izviđač"

#: data/units.json
msgid "Rides out to see a horde's numbers before it arrives."
msgstr "Jaše da vidi koliko je horda velika pre nego što stigne."

#: data/units.json
msgid "A tracker who moves fast and keeps out of sight; worth two scouts in a report or an army. Each one marching with an army takes 5% off how much harsh terrain slows it (at most 50%)."
msgstr "Tragač koji se kreće brzo i ostaje neviđen; vredi kao dva izviđača u izveštaju ili vojsci. Svaki koji maršira uz vojsku skida 5% od toga koliko je težak teren usporava (najviše 50%)."

#: data/units.json
msgid "Assassin"
msgstr "Ubica"

#: data/units.json
msgid "Slips into a horde's camp unseen and may kill its leader; worth three scouts in a report or an army."
msgstr "Neviđen se uvlači u logor horde i može ubiti njenog vođu; vredi kao tri izviđača u izveštaju ili vojsci."

#: data/units.json
msgid "Settler"
msgstr "Doseljenik"

#: data/units.json
msgid "Founds a new village where you send them; no use in a fight."
msgstr "Osniva novo selo tamo gde ga pošalješ; u borbi ne vredi."

#: data/units.json
msgid "Forest Archer"
msgstr "Šumski strelac"

#: data/units.json
msgid "The lynx-folk's own: archers who strike from the trees."
msgstr "Samo risov rod: strelci koji udaraju iz krošnji."

#: data/units.json
msgid "River Barge"
msgstr "Rečna barka"

#: data/units.json
msgid "The beaver-folk's own: a river crew who carry a great load and hold firm."
msgstr "Samo dabrov rod: rečna posada koja nosi veliki teret i čvrsto stoji."

#: data/units.json
msgid "Border Rider"
msgstr "Granični jahač"

#: data/units.json
msgid "The falcon-folk's own: light riders who see far and ride fast."
msgstr "Samo sokolov rod: laki konjanici koji vide daleko i jašu brzo."

#: data/units.json
msgid "Shaman"
msgstr "Šaman"

#: data/units.json
msgid "Knows the herbs and the old words: in battle, each Shaman gives every soldier who falls beside them a 5% chance to get up again (at most 50%). Fights little."
msgstr "Zna trave i stare reči: u bici svaki Šaman daje svakom vojniku koji padne pored njega 5% šanse da ponovo ustane (najviše 50%). Malo se bori."

#: data/units.json
msgid "Military Caravan"
msgstr "Vojna karavana"

#: data/units.json
msgid "A covered wagon of grain for the march; standing in the open, the wagons are drawn into a ring for a wagon fort."
msgstr "Pokrivena kola sa žitom za pohod; na otvorenom polju kola se zbijaju u krug, u kolski tabor."

#: data/units.json
msgid "Large Military Caravan"
msgstr "Veliki vojni karavan"

#: data/units.json
msgid "A long covered wagon behind a team of oxen: it carries 10 foot soldiers or 1 siege engine (engines first), who ride at its pace instead of marching, and 300 grain for the army. Standing in the open, it is drawn into the wagon fort."
msgstr "Dugačka pokrivena kola za zapregom volova: nosi 10 pešaka ili 1 opsadnu spravu (prvo sprave), koji se voze njegovim korakom umesto da marširaju, i 300 žita za vojsku. Na otvorenom se uvlači u utvrđenje od kola."

#: data/units.json
msgid "Aurochs Guard"
msgstr "Turova garda"

#: data/units.json
msgid "The aurochs-folk's own: shield-walls that do not break."
msgstr "Turovog naroda: zidovi od štitova koji se ne lome."

#: data/units.json
msgid "Raven Javelineer"
msgstr "Gavranov kopljobacač"

#: data/units.json
msgid "The raven-folk's own: skirmishers who strike first and see far."
msgstr "Gavranovog naroda: čarkaši koji udaraju prvi i vide daleko."

#: data/units.json
msgid "Fox Rider"
msgstr "Lisičji jahač"

#: data/units.json
msgid "The fox-folk's own: quick riders who carry off twice the spoils."
msgstr "Lisičjeg naroda: brzi jahači koji odnose dvostruki plen."

#: data/units.json
msgid "Serpent Axeman"
msgstr "Zmijin sekiraš"

#: data/units.json
msgid "The serpent-folk's own: heavy axes that bite through shields."
msgstr "Zmijinog naroda: teške sekire koje seku kroz štitove."

#: data/walls.json
msgid "Timber Rampart"
msgstr "Drveni bedem"

#: data/walls.json
msgid "Stone Wall"
msgstr "Kameni bedem"

#: data/walls.json
msgid "Fortress Walls"
msgstr "Tvrđavski bedemi"

#: data/waves.json
msgid "Low"
msgstr "Niska"

#: data/waves.json
msgid "Moderate"
msgstr "Umerena"

#: data/waves.json
msgid "High"
msgstr "Visoka"

#: data/waves.json
msgid "Severe"
msgstr "Teška"
