#: data/onboarding.json
msgid "Raise a building"
msgstr "Podigni građevinu"

#: data/onboarding.json
msgid "Open your village and queue any building or field upgrade."
msgstr "Otvori svoje selo i stavi u red bilo koju gradnju ili unapređenje polja."

#: data/onboarding.json
msgid "The elder looks at the thin palisade and the half-empty fields. \"Walls and bread first, child. Everything else grows from them.\""
msgstr "Starešina gleda tanku palisadu i polupuna polja. „Prvo zidovi i hleb, dete. Sve ostalo raste iz njih.“"

#: data/onboarding.json
msgid "Train defenders"
msgstr "Obuči branioce"

#: data/onboarding.json
msgid "Build a Barracks and train any unit there."
msgstr "Sagradi kasarnu i obuči bilo koju jedinicu u njoj."

#: data/onboarding.json
msgid "\"The hordes do not wait for the harvest. Put spears in the hands of those who can hold them.\""
msgstr "„Horde ne čekaju žetvu. Daj koplja u ruke onima koji mogu da ih drže.“"

#: data/onboarding.json
msgid "Claim an outpost"
msgstr "Zauzmi ispostavu"

#: data/onboarding.json
msgid "Tap a forest, hill, field or mine hex near your village and claim it."
msgstr "Dodirni polje šume, brda, njive ili rudnika blizu svog sela i zauzmi ga."

#: data/onboarding.json
msgid "\"The land around us is rich, and nobody tends it. Set a camp there before the beasts do.\""
msgstr "„Zemlja oko nas je bogata, a niko je ne obrađuje. Podigni tamo logor pre zveri.“"

#: data/onboarding.json
msgid "Send scouts"
msgstr "Pošalji izviđače"

#: data/onboarding.json
msgid "Build a Scout Lodge and send scouts at a horde, a camp or an ancient site."
msgstr "Sagradi izviđačnicu i pošalji izviđače na hordu, logor ili drevno mesto."

#: data/onboarding.json
msgid "\"Fear is what you feel about a thing you have not seen. Go and see it.\""
msgstr "„Strah je ono što osećaš prema nečemu što nisi video. Idi i pogledaj.“"

#: data/onboarding.json
msgid "Clear your first camp"
msgstr "Očisti svoj prvi logor"

#: data/onboarding.json
msgid "Send an army to storm a monster camp or a lair (order: storm it)."
msgstr "Pošalji vojsku da napadne logor ili jazbinu čudovišta (naredba: napadni)."

#: data/onboarding.json
msgid "\"A camp of beasts in the woods is a wave that has not yet happened. Burn it out.\""
msgstr "„Logor zveri u šumi je talas koji se još nije desio. Spali ga.“"

#: data/onboarding.json
msgid "Gift a teammate"
msgstr "Daruj saveznika"

#: data/onboarding.json
msgid "Send a caravan to a teammate's village or to the Holy City vault."
msgstr "Pošalji karavan u selo saveznika ili u riznicu Svetog grada."

#: data/onboarding.json
msgid "\"No village stands alone. What you share now comes back to you on the night the walls shake.\""
msgstr "„Nijedno selo ne stoji samo. Ono što sada podeliš vratiće ti se u noći kad se zidovi zatresu.“"

