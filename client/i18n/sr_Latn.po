#: data/onboarding.json
msgid "Raise a building"
msgstr "Podigni građevinu"

#: data/onboarding.json
msgid "Open your village and queue any building or field upgrade."
msgstr "Otvori svoje selo i stavi u red bilo koju gradnju ili unapređenje polja."

#: data/onboarding.json
msgid "The elder looks at the thin palisade and the half-empty fields. \"Walls and bread first, child. Everything else grows from them.\""
msgstr "Starešina gleda tanku palisadu i polupuna polja. „Prvo zidovi i hleb, dete. Sve ostalo raste iz njih.“"

#: data/onboarding.json
msgid "Tap Village in the top bar."
msgstr "Dodirni Selo na gornjoj traci."

#: data/onboarding.json
msgid "Tap an empty plot or a building in the village."
msgstr "Dodirni prazno mesto ili zgradu u selu."

#: data/onboarding.json
msgid "Tap Build or Upgrade in the sheet."
msgstr "Dodirni Gradi ili Unapredi na listu."

#: data/onboarding.json
msgid "Train defenders"
msgstr "Obuči branioce"

#: data/onboarding.json
msgid "Build a Barracks and train any unit there."
msgstr "Sagradi kasarnu i obuči bilo koju jedinicu u njoj."

#: data/onboarding.json
msgid "\"The hordes do not wait for the harvest. Put spears in the hands of those who can hold them.\""
msgstr "„Horde ne čekaju žetvu. Daj koplja u ruke onima koji mogu da ih drže.“"

#: data/onboarding.json
msgid "Build a Barracks on a free plot in the village (no free plot? Upgrade the Elder's Hall: each level opens one)."
msgstr "Izgradi Kasarnu na slobodnom mestu u selu (nema slobodnog mesta? Unapredi Dom starešina: svaki nivo otvara jedno)."

#: data/onboarding.json
msgid "When it stands, open the Troops tab."
msgstr "Kad bude gotova, otvori karticu Trupe."

#: data/onboarding.json
msgid "Pick a unit and a number, then tap Train."
msgstr "Izaberi jedinicu i broj, pa dodirni Obuka."

#: data/onboarding.json
msgid "Claim an outpost"
msgstr "Zauzmi ispostavu"

#: data/onboarding.json
msgid "Tap a forest, hill, field or mine hex near your village and claim it."
msgstr "Dodirni polje šume, brda, njive ili rudnika blizu svog sela i zauzmi ga."

#: data/onboarding.json
msgid "\"The land around us is rich, and nobody tends it. Set a camp there before the beasts do.\""
msgstr "„Zemlja oko nas je bogata, a niko je ne obrađuje. Podigni tamo logor pre zveri.“"

#: data/onboarding.json
msgid "Go back to the map."
msgstr "Vrati se na mapu."

#: data/onboarding.json
msgid "Tap a forest, hills, plains, mountain or lake hex next to your village."
msgstr "Dodirni polje šume, brda, ravnice, planine ili jezera pored svog sela."

#: data/onboarding.json
msgid "In the sheet, tap Claim beside Build an outpost."
msgstr "Na listu dodirni Prisvoji pored Gradi ispostavu."

#: data/onboarding.json
msgid "Build a Scout Lodge and send scouts at a horde, a camp or an ancient site."
msgstr "Sagradi izviđačnicu i pošalji izviđače na hordu, logor ili drevno mesto."

#: data/onboarding.json
msgid "\"Fear is what you feel about a thing you have not seen. Go and see it.\""
msgstr "„Strah je ono što osećaš prema nečemu što nisi video. Idi i pogledaj.“"

#: data/onboarding.json
msgid "Build a Scout Lodge on a free plot in the village (no free plot? Upgrade the Elder's Hall)."
msgstr "Izgradi Izviđačnicu na slobodnom mestu u selu (nema slobodnog mesta? Unapredi Dom starešina)."

#: data/onboarding.json
msgid "Tap the threat line in the top bar."
msgstr "Dodirni red sa pretnjom na gornjoj traci."

#: data/onboarding.json
msgid "Pick a horde and tap Send scouts."
msgstr "Izaberi hordu i dodirni Pošalji izviđače."

#: data/onboarding.json
msgid "Clear your first camp"
msgstr "Očisti svoj prvi logor"

#: data/onboarding.json
msgid "Send an army to storm a bandit camp or a lair (order: storm it)."
msgstr "Pošalji vojsku da juriša na razbojnički logor ili jazbinu (naredba: juriš)."

#: data/onboarding.json
msgid "\"A camp of beasts in the woods is a wave that has not yet happened. Burn it out.\""
msgstr "„Logor zveri u šumi je talas koji se još nije desio. Spali ga.“"

#: data/onboarding.json
msgid "Find a camp on the map: there is one near your village (the tents)."
msgstr "Nađi logor na mapi: jedan je blizu tvog sela (šatori)."

#: data/onboarding.json
msgid "Tap it, choose your troops in the sheet and order them to storm it."
msgstr "Dodirni ga, izaberi trupe na listu i naredi im da ga napadnu."

#: data/onboarding.json
msgid "Gift a teammate"
msgstr "Daruj saveznika"

#: data/onboarding.json
msgid "Send a caravan to a teammate's village or to the Holy City vault."
msgstr "Pošalji karavan u selo saveznika ili u riznicu Svetog grada."

#: data/onboarding.json
msgid "\"No village stands alone. What you share now comes back to you on the night the walls shake.\""
msgstr "„Nijedno selo ne stoji samo. Ono što sada podeliš vratiće ti se u noći kad se zidovi zatresu.“"

#: data/onboarding.json
msgid "Build a Caravan Yard on a free plot in the village (no free plot? Upgrade the Elder's Hall: each level opens one)."
msgstr "Izgradi Karavansko dvorište na slobodnom mestu u selu (nema slobodnog mesta? Unapredi Dom starešina: svaki nivo otvara jedno)."

#: data/onboarding.json
msgid "Open the Caravans tab."
msgstr "Otvori karticu Karavani."

#: data/onboarding.json
msgid "Load resources and send them to a teammate or to the Holy City vault."
msgstr "Natovari resurse i pošalji ih saigraču ili u riznicu Svetog grada."

#: data/onboarding.json
msgid "Fill the Holy City's vault"
msgstr "Napuni riznicu Svetog grada"

#: data/onboarding.json
msgid "Send a caravan of resources to the Holy City vault."
msgstr "Pošalji karavan sa resursima u riznicu Svetog grada."

#: data/onboarding.json
msgid "\"The Holy City feeds the bridge and the guard on its walls. What you send now comes back to you on the night the walls shake.\""
msgstr "„Sveti grad hrani most i stražu na svojim zidinama. Ono što pošalješ sada vratiće ti se one noći kad se zidine zatresu.“"

#: data/onboarding.json
msgid "Load resources and send them to the Holy City vault."
msgstr "Natovari resurse i pošalji ih u riznicu Svetog grada."

#: data/onboarding.json
msgid "Ready for the hordes"
msgstr "Spreman za horde"

#: data/onboarding.json
msgid "The elder nods at last. \"Now you know the ways of the steppe and the forest. The rest you will learn from the hordes themselves.\""
msgstr "Starešina konačno klimne glavom. „Sada znaš puteve stepe i šume. Ostalo ćeš naučiti od samih hordi.“"

#: data/quests.json
msgid "Ambush the horde's road"
msgstr "Zaseda na putu horde"

