msgstr "Otvori junaka"

#: client/scripts/screens/game_screen_base.gd:400
msgid "The stores of %s: each village keeps its own."
msgstr "Zalihe sela %s: svako selo čuva svoje."

#: client/scripts/screens/game_screen_base.gd:410
msgid "%s: %s an hour, credited every minute (next in %s)"
msgstr "%s: %s na sat, pripisuje se svakog minuta (sledeće za %s)"

#: client/scripts/screens/game_screen_base.gd:411
msgid "%s/min"
msgstr "%s/min"

#: client/scripts/screens/game_screen_base.gd:484
msgid "Your Svarog's Embers: found in ancient sites and lairs, spent on the bridge, the Shrine and the mightiest research."
msgstr "Tvoj Svarogov žar: nalazi se u drevnim mestima i jazbinama, troši se na most, svetilište i najmoćnija istraživanja."

#: client/scripts/screens/game_screen_base.gd:544
msgid "Inbox"
msgstr "Prijemno sanduče"

#: client/scripts/screens/game_screen_base.gd:544
msgid "Inbox and chat"
msgstr "Obaveštenja i ćaskanje"

#: client/scripts/screens/game_screen_base.gd:632
msgid "Tutorial hidden. More → Tutorial brings it back."
msgstr "Uputstvo je sakriveno. Više → Uputstvo ga vraća."

