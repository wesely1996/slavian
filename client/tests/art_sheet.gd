extends SceneTree
## Renders every piece of art in client/art/art.json onto one sheet:
##   godot --path client --resolution 1400x1760 --script res://tests/art_sheet.gd -- <out.png>
## (needs a display; under CI use xvfb-run). docs/art/style-sample.png is made with it.

const SECTIONS := [
	["Terrain", "terrain/"],
	["Settlements: by Elder's Hall level, ruins, the Holy City", "settlement/"],
	["On the map: camps and lairs, forts, outposts", "map/"],
	["Ancient sites", "site/"],
	["Units", "unit/"],
	["Hordes", "faction/"],
	["Resources and Svarog's Ember", "resource/"],
]
const SIDES := [["Yours", Color("#4caf50")], ["Allies'", Color("#3f7fd6")], ["Enemies'", Color("#d0453a")]]
const INK := Color("#2b2118")


func _initialize() -> void:
	_run()


func _run() -> void:
	# One to one: the project stretches its phone layout, the sheet doesn't.
	root.content_scale_mode = Window.CONTENT_SCALE_MODE_DISABLED
	var out: String = OS.get_cmdline_user_args()[0] if OS.get_cmdline_user_args().size() > 0 else "user://style-sample.png"
	var page := ColorRect.new()
	page.color = Color("#efe2c1")
	page.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	root.add_child(page)
	var margin := MarginContainer.new()
	margin.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	for side in ["left", "right", "top", "bottom"]:
		margin.add_theme_constant_override("margin_" + side, 28)
	page.add_child(margin)
	var column := VBoxContainer.new()
	column.add_theme_constant_override("separation", 10)
	margin.add_child(column)
	column.add_child(_label("Slavian: style sample", 40))
	column.add_child(_label("Generated by tools/art/generate.py; every piece can be replaced through client/art/art.json (docs/art-style.md).", 18))
	for section in SECTIONS:
		column.add_child(_label(section[0], 24))
		var row := HFlowContainer.new()
		row.add_theme_constant_override("h_separation", 14)
		row.add_theme_constant_override("v_separation", 8)
		for id in Art.ids():
			if String(id).begins_with(section[1]):
				row.add_child(_tile(id))
		column.add_child(row)
	column.add_child(_label("Owners: the banner's cloth takes the owner's colour, and so does the outline", 24))
	var owners := HBoxContainer.new()
	owners.add_theme_constant_override("separation", 24)
	for side in SIDES:
		owners.add_child(_owned(side[0], side[1]))
	owners.add_child(_tile("app/icon"))
	column.add_child(owners)
	for i in 6:
		await process_frame
	root.get_texture().get_image().save_png(out)
	print("saved ", out)
	quit()


func _label(text: String, size: int) -> Label:
	var label := Label.new()
	label.text = text
	label.add_theme_font_size_override("font_size", size)
	label.add_theme_color_override("font_color", INK)
	label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	return label


func _tile(id: String) -> Control:
	var box := VBoxContainer.new()
	var pic := TextureRect.new()
	pic.texture = Art.texture(id)
	pic.custom_minimum_size = Vector2(96, 96)
	pic.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	pic.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	box.add_child(pic)
	var name := _label(String(id).get_slice("/", 1).replace("_", " "), 15)
	name.autowrap_mode = TextServer.AUTOWRAP_OFF
	name.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	name.custom_minimum_size.x = 104
	box.add_child(name)
	return box


## A village of the given side: outlined and bannered in its colour.
func _owned(title: String, color: Color) -> Control:
	var box := VBoxContainer.new()
	var stage := Control.new()
	stage.custom_minimum_size = Vector2(170, 170)
	var ring := Panel.new()
	var style := StyleBoxFlat.new()
	style.bg_color = Color(color, 0.18)
	style.border_color = color
	style.set_border_width_all(5)
	style.set_corner_radius_all(80)
	ring.add_theme_stylebox_override("panel", style)
	ring.position = Vector2(8, 96)
	ring.size = Vector2(150, 56)
	stage.add_child(ring)
	var village := TextureRect.new()
	village.texture = Art.texture("settlement/village_4")
	village.position = Vector2(19, 10)
	village.size = Vector2(128, 128)
	stage.add_child(village)
	var pole := TextureRect.new()
	pole.texture = Art.texture("banner/pole")
	pole.position = Vector2(118, 4)
	pole.size = Vector2(40, 60)
	pole.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	stage.add_child(pole)
	var cloth := TextureRect.new()
	cloth.texture = Art.texture("banner/cloth")
	cloth.position = pole.position
	cloth.size = pole.size
	cloth.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	cloth.modulate = color
	stage.add_child(cloth)
	box.add_child(stage)
	var name := _label(title, 16)
	name.autowrap_mode = TextServer.AUTOWRAP_OFF
	name.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(name)
	return box
