# Production settings (docs/production.md). Copy to .env and fill in; .env,
# fcm.json, costs.json and backups/ stay out of git.

# The server's public address: its DNS A/AAAA record points at this machine.
DOMAIN=play.example.com

# Optional parts of the compose file: local-db (Postgres on this machine)
# and offsite (backups copied off the machine, below).
COMPOSE_PROFILES=local-db,offsite

# The database. On this machine (local-db):
#   postgres://slavian:<POSTGRES_PASSWORD>@postgres:5432/slavian
# or a hosted one, such as Neon's *direct* (not pooled) connection string.
# Moving from Neon to this machine: ./move-db.sh fills these in.
DATABASE_URL=postgres://slavian:change-me@postgres:5432/slavian
# A long random password, for example: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# The Postgres major version, here and for the backups' tools.
POSTGRES_VERSION=17

# Push notifications (docs/push.md): put the Firebase service-account key
# next to this file as fcm.json, then uncomment.
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm.json

# Error alerts: a Discord or Slack incoming webhook (optional).
ALERT_WEBHOOK_URL=
ALERT_NAME=prod

# Nightly backups: hour (UTC) and how many days to keep.
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14

# Backups off the machine (offsite): an S3-compatible bucket, for example
# Cloudflare R2 (free up to 10 GB). R2: Storage → Create bucket, then
# Manage API tokens → an "Object Read & Write" token for that bucket.
OFFSITE_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
OFFSITE_BUCKET=slavian-backups
OFFSITE_ACCESS_KEY_ID=
OFFSITE_SECRET_ACCESS_KEY=
OFFSITE_KEEP_DAYS=30

# Which server image to run: main (every merge) or a commit's sha.
SLAVIAN_TAG=main
