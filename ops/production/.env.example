# Production settings (docs/production.md). Copy to .env and fill in; .env,
# fcm.json, costs.json and backups/ stay out of git.

# The server's public address: its DNS A/AAAA record points at this machine.
DOMAIN=play.example.com

# Neon's *direct* (not pooled) connection string, or, with --profile local-db:
# postgres://slavian:<POSTGRES_PASSWORD>@postgres:5432/slavian
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/slavian?sslmode=require
# POSTGRES_PASSWORD=change-me

# Push notifications (docs/push.md): put the Firebase service-account key
# next to this file as fcm.json, then uncomment.
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm.json

# Error alerts: a Discord or Slack incoming webhook (optional).
ALERT_WEBHOOK_URL=
ALERT_NAME=prod

# Nightly backups: hour (UTC) and how many days to keep.
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14

# Which server image to run: main (every merge) or a commit's sha.
SLAVIAN_TAG=main
